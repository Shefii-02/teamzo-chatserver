PORT=3005
# Same MySQL database + credentials as the Laravel backend (copy DB_* from backend/.env)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teamzo
DB_USERNAME=root
DB_PASSWORD=
# Must equal Laravel's JWT_SECRET (staff sockets + REST verify the Laravel JWT locally)
JWT_SECRET=
# Must equal Laravel's INTERNAL_API_KEY (Laravel -> /api/internal/*, and chat-server -> Laravel /internal/*)
INTERNAL_API_KEY=
# Laravel base URL (permission checks + team-chat push)
# local dev: LARAVEL_INTERNAL_URL=http://localhost:8000
LARAVEL_INTERNAL_URL=https://api.teamzo.io
# Laravel app timezone (DATETIME wall-clock)
APP_TIMEZONE=Asia/Kolkata
# Browser-reachable Laravel URL, used to build attachment links (<url>/storage/...)
LARAVEL_PUBLIC_URL=https://api.teamzo.io
